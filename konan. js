
const MODEL = "nvidia/nemotron-3.5-super-vl:free";

async function askAI(text, apiKey) {
  const response = await fetch(
    "https://openrouter.ai/api/v1/chat/completions",
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${apiKey}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model: MODEL,
        messages: [
          {
            role: "system",
            content: "أنت KONAN AI، مساعد ذكي يجيب بالعربية بوضوح."
          },
          { role: "user", content: text }
        ],
        max_tokens: 800
      })
    }
  );

  if (!response.ok) {
    throw new Error(`OpenRouter error: ${response.status}`);
  }

  const data = await response.json();
  return data.choices?.[0]?.message?.content
    || "لم أتمكن من الإجابة الآن.";
}

async function sendTelegramMessage(chatId, text, botToken) {
  const response = await fetch(
    `https://api.telegram.org/bot${botToken}/sendMessage`,
    {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        chat_id: chatId,
        text: text.slice(0, 4000)
      })
    }
  );

  if (!response.ok) {
    throw new Error(`Telegram error: ${response.status}`);
  }
}

export async function handleUpdate(update, secrets) {
  const message = update?.message;
  if (!message?.chat?.id || !message?.text) return;

  const chatId = message.chat.id;
  const text = message.text.trim();

  if (text === "/start") {
    await sendTelegramMessage(
      chatId,
      "أهلًا بك في KONAN AI 🤖\nأرسل سؤالك.",
      secrets.TELEGRAM_BOT_TOKEN
    );
    return;
  }

  try {
    const answer = await askAI(text, secrets.OPENROUTER_API_KEY);
    await sendTelegramMessage(
      chatId,
      answer,
      secrets.TELEGRAM_BOT_TOKEN
    );
  } catch (error) {
    console.error("Request failed:", error.message);
    await sendTelegramMessage(
      chatId,
      "حدث خطأ مؤقت. حاول مرة أخرى لاحقًا.",
      secrets.TELEGRAM_BOT_TOKEN
    );
  }
}
